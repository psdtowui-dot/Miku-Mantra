# ==============================================================
# MikuMantra Fine Jewellery - Environment Configuration Template
# COPY this file to .env or .env.local and fill in your actual credentials.
# NEVER commit .env or secrets to version control (Git).
# ==============================================================

# MongoDB Connection
# Replace with your MongoDB Atlas or self-hosted URI
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/userPortal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/userPortal?retryWrites=true&w=majority
DB_NAME=userPortal

# Direct replica set URI fallback (optional, used if local network blocks SRV lookups)
MONGO_DIRECT_URL=

# Super Administrator Email Addresses (comma-separated)
# Users with these email addresses are automatically granted Super Admin privileges
ADMIN_EMAIL=admin@mikumantra.com
ADMIN_EMAILS=admin@mikumantra.com

# Base Application URL
NEXT_PUBLIC_BASE_URL=https://mikumantra.com

# Allowed CORS Origins (comma-separated, or * in dev)
CORS_ORIGINS=https://mikumantra.com,https://admin.mikumantra.com

# Google OAuth 2.0 (From Google Cloud Console: APIs & Services > Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP / Email Service Configuration (for order notifications, verification, and password resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="MikuMantra" <no-reply@mikumantra.com>

# Razorpay Payment Gateway (Optional, test mode or live mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Google Gemini AI Concierge (Optional)
GEMINI_API_KEY=your_gemini_api_key
